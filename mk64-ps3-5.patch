diff --git a/ps3/shaders/build_shaders.sh b/ps3/shaders/build_shaders.sh
new file mode 100755
index 0000000..8445d13
--- /dev/null
+++ b/ps3/shaders/build_shaders.sh
@@ -0,0 +1,31 @@
+#!/bin/sh
+# Rebuilds ../source/ps3_shader_data.h from the Cg sources. Only needed when a
+# shader changes: the header is committed, so building the port needs neither
+# Cg nor cgcomp.
+#
+# Needs cgc (NVIDIA Cg Toolkit 3.1: apt-get install nvidia-cg-toolkit) and
+# PSL1GHT's cgcomp ($PS3DEV/bin).
+set -e
+cd "$(dirname "$0")"
+CGCOMP=${CGCOMP:-$PS3DEV/bin/cgcomp}
+"$CGCOMP" -v mk64_vp.vcg mk64_vp.vpo
+"$CGCOMP" -f mk64_fp.fcg mk64_fp.fpo
+python3 - <<'PY'
+def arr(name, path):
+    d = open(path, 'rb').read()
+    rows = [', '.join('0x%02x' % b for b in d[i:i + 12]) for i in range(0, len(d), 12)]
+    return ('static const unsigned char %s[] __attribute__((aligned(16))) = {\n  %s\n};\n'
+            % (name, ',\n  '.join(rows)))
+out = ('/* ps3_shader_data.h -- the RSX shaders, PRECOMPILED.\n'
+       ' *\n'
+       ' * Generated by shaders/build_shaders.sh from shaders/mk64_vp.vcg and\n'
+       ' * shaders/mk64_fp.fcg. Do not edit.\n'
+       ' */\n'
+       '#ifndef PS3_SHADER_DATA_H\n#define PS3_SHADER_DATA_H\n\n'
+       + arr('shader_vp_data', 'mk64_vp.vpo') + '\n'
+       + arr('shader_fp_data', 'mk64_fp.fpo') + '\n'
+       '#endif /* PS3_SHADER_DATA_H */\n')
+open('../source/ps3_shader_data.h', 'w').write(out)
+PY
+rm -f mk64_vp.vpo mk64_fp.fpo
+echo "wrote ../source/ps3_shader_data.h"
diff --git a/ps3/shaders/mk64_fp.fcg b/ps3/shaders/mk64_fp.fcg
new file mode 100644
index 0000000..1a7d34b
--- /dev/null
+++ b/ps3/shaders/mk64_fp.fcg
@@ -0,0 +1,30 @@
+// mk64-ps3 fragment program: the N64 colour combiner, (A - B) * C + D for
+// colour and for alpha, plus fog.
+//
+// Each of A, B, C, D is "a constant or the texel". The constant part (prim,
+// env, shade, 0, 1...) is worked out on the CPU and arrives interpolated in
+// ca..cd. The texel part is switched on with weights that are 0 or 1:
+//   w0.xy  A += x * texel.rgb + y * texel.aaa      w0.zw  the same for B
+//   w1.xy  the same for C                          w1.zw  the same for D
+//   wa     alpha of A, B, C, D += texel.a
+// fog.rgb is the fog colour and fog.a how much of it (0 = none).
+float4 main(float4 fog : COLOR0,
+            float2 uv  : TEXCOORD0,
+            float4 ca  : TEXCOORD1,
+            float4 cb  : TEXCOORD2,
+            float4 cc  : TEXCOORD3,
+            float4 cd  : TEXCOORD4,
+            float4 w0  : TEXCOORD5,
+            float4 w1  : TEXCOORD6,
+            float4 wa  : TEXCOORD7,
+            uniform sampler2D tex : TEXUNIT0) : COLOR
+{
+    float4 t = tex2D(tex, uv);
+    float4 a = ca + float4(w0.x * t.rgb + w0.y * t.aaa, wa.x * t.a);
+    float4 b = cb + float4(w0.z * t.rgb + w0.w * t.aaa, wa.y * t.a);
+    float4 c = cc + float4(w1.x * t.rgb + w1.y * t.aaa, wa.z * t.a);
+    float4 d = cd + float4(w1.z * t.rgb + w1.w * t.aaa, wa.w * t.a);
+    float4 o = saturate((a - b) * c + d);
+    o.rgb = lerp(o.rgb, fog.rgb, fog.a);
+    return o;
+}
diff --git a/ps3/shaders/mk64_vp.vcg b/ps3/shaders/mk64_vp.vcg
new file mode 100644
index 0000000..b62bd73
--- /dev/null
+++ b/ps3/shaders/mk64_vp.vcg
@@ -0,0 +1,34 @@
+// mk64-ps3 vertex program: positions arrive in clip space, everything else
+// is passed through to the fragment program.
+void main(float4 pos  : POSITION,
+          float4 fog  : COLOR0,
+          float2 uv   : TEXCOORD0,
+          float4 ca   : TEXCOORD1,
+          float4 cb   : TEXCOORD2,
+          float4 cc   : TEXCOORD3,
+          float4 cd   : TEXCOORD4,
+          float4 w0   : TEXCOORD5,
+          float4 w1   : TEXCOORD6,
+          float4 wa   : TEXCOORD7,
+          out float4 opos : POSITION,
+          out float4 ofog : COLOR0,
+          out float2 ouv  : TEXCOORD0,
+          out float4 oca  : TEXCOORD1,
+          out float4 ocb  : TEXCOORD2,
+          out float4 occ  : TEXCOORD3,
+          out float4 ocd  : TEXCOORD4,
+          out float4 ow0  : TEXCOORD5,
+          out float4 ow1  : TEXCOORD6,
+          out float4 owa  : TEXCOORD7)
+{
+    opos = pos;
+    ofog = fog;
+    ouv  = uv;
+    oca  = ca;
+    ocb  = cb;
+    occ  = cc;
+    ocd  = cd;
+    ow0  = w0;
+    ow1  = w1;
+    owa  = wa;
+}
