+/* ps3_gfx_walk.h -- what the display list walker found in the last frame. */
+
+#ifndef PS3_GFX_WALK_H
+#define PS3_GFX_WALK_H
+
+typedef struct {
+    unsigned frame;                       /* frames walked so far */
+    unsigned commands;
+    unsigned dlCalls, maxDepth;
+    unsigned vtxLoads, vertices, triangles;
+    unsigned matrices, textures;
+    unsigned texRects, fillRects;
+    unsigned errors;                      /* this frame */
+    unsigned totalErrors;                 /* since boot */
+} ps3_gfx_stats_t;
+
+extern ps3_gfx_stats_t gPs3GfxStats;
+
+#endif /* PS3_GFX_WALK_H */
diff --git a/ps3/source/game/ps3_mem.S b/ps3/source/game/ps3_mem.S
new file mode 100644
index 0000000..158899a
--- /dev/null
+++ b/ps3/source/game/ps3_mem.S
@@ -0,0 +1,48 @@
+/* ps3_mem.S -- the memory the N64 linker script laid out by hand.
+ *
+ * On the N64 the game heap is the RAM between the end of the main segment's
+ * bss and the "racing" code segment: the game takes memory upwards from
+ * _memoryPoolSegmentNoloadStart and downwards from _racingSegmentStart
+ * (gHeapEndPtr). The "ending" segment sits in between and is only loaded for
+ * the award ceremony and the credits.
+ *
+ *   N64:  pool start 0x801978D0, pool end +0xAB630, ending +0xE8730,
+ *         racing +0xF6630  (about 1 MB in all)
+ *
+ * Here the code segments are part of the executable, so the labels only mark
+ * the limits of the heap. It is 1 MB larger than on the N64 because structures
+ * with native (64-bit) pointers are bigger.
+ */
+
+#define HEAP_EXTRA  0x100000
+
+    .section .bss
+    .balign 16
+
+    .globl _memoryPoolSegmentNoloadStart
+    .globl _memoryPoolSegmentNoloadEnd
+    .globl _endingSegmentStart
+    .globl _endingSegmentNoloadEnd
+    .globl _racingSegmentStart
+    .globl _racingSegmentNoloadEnd
+_memoryPoolSegmentNoloadStart:
+    .space 0xAB630
+_memoryPoolSegmentNoloadEnd:
+    .space 0xE8730 - 0xAB630 + HEAP_EXTRA
+_endingSegmentStart:
+    .space 0xDF00
+_endingSegmentNoloadEnd:
+_racingSegmentStart:
+    .space 0x100
+_racingSegmentNoloadEnd:
+
+/* Trig tables: 0x5810 bytes read from the ROM by setup_game_memory(). */
+    .balign 16
+    .globl _trigTablesSegmentStart
+    .globl gSineTable
+    .globl gArctanTable
+_trigTablesSegmentStart:
+gSineTable:
+    .space 0x5000
+gArctanTable:
+    .space 0x810
diff --git a/ps3/source/game/ps3_romdata.c b/ps3/source/game/ps3_romdata.c
new file mode 100644
index 0000000..11c718f
--- /dev/null
+++ b/ps3/source/game/ps3_romdata.c
@@ -0,0 +1,36 @@
+/* ps3_romdata.c -- data of the N64 "main" segment that the game source does
+ * not contain (the decompilation extracts it from the ROM at build time).
+ *
+ * The native array is left empty and filled here from the user's ROM. The main
+ * segment is loaded at 0x80000400 from ROM offset 0x1000, so the ROM offset of
+ * a main-segment address is addr - 0x80000400 + 0x1000.
+ */
+
+#include <ultra64.h>
+
+#include "ps3_game.h"
+#include "ps3_rom.h"
+
+#define MAIN_ROM(vaddr) ((u32) ((vaddr) - 0x80000400U + 0x1000U))
+
+extern u8 D_800E52D0[];                   /* src/data/some_data.c: gTLUTOnomatopoeia */
+
+static const struct {
+    const char* name;
+    u8* dest;
+    u32 vaddr;
+    u32 size;
+} sRomData[] = {
+    { "gTLUTOnomatopoeia", D_800E52D0, 0x800E52D0, 0x200 },
+};
+
+void ps3_romdata_load(void) {
+    u32 i;
+
+    for (i = 0; i < sizeof(sRomData) / sizeof(sRomData[0]); i++) {
+        if (PS3_Rom_Read(sRomData[i].dest, MAIN_ROM(sRomData[i].vaddr), sRomData[i].size) != 0) {
+            ps3_logf("[romdata] could not read %s", sRomData[i].name);
+        }
+    }
+    ps3_logf("[romdata] %u block(s) read from the ROM", (unsigned) i);
+}
diff --git a/ps3/source/game/ps3_ultra.c b/ps3/source/game/ps3_ultra.c
new file mode 100644
index 0000000..e36dd39
--- /dev/null
+++ b/ps3/source/game/ps3_ultra.c
@@ -0,0 +1,419 @@
+/* ps3_ultra.c -- the part of libultra the game calls, for a single thread.
+ *
+ * On the N64 the game is four threads talking through message queues (video,
+ * audio, game loop, idle) plus the RSP. Here the game loop is the only thread:
+ *   - message queues are real ring buffers, but nothing ever blocks: a
+ *     blocking receive on an empty queue returns at once, because nobody else
+ *     could fill it;
+ *   - a ROM read (osPiStartDma) is done on the spot from the ROM in memory;
+ *   - osViSwapBuffer() is the end of the frame.
+ */
+
+#include <ultra64.h>
+#include <PR/os.h>
+#include <PR/ucode.h>
+#include <string.h>
+#include <stdarg.h>
+#include <stdio.h>
+
+#include "ps3_game.h"
+#include "ps3_plat.h"
+#include "ps3_rom.h"
