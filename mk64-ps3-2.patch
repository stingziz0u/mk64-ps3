+
+#include "ps3_plat.h"
+#include "ps3_pad_bits.h"
+#include "ps3_log.h"
+#include "ps3_video.h"
+#include "ps3_pad.h"
+
+/* ps3_pad_bits.h repeats these values for the game side. */
+typedef char pad_bits_match[(PS3PAD_CROSS == PAD_CROSS && PS3PAD_START == PAD_START &&
+                             PS3PAD_L2 == PAD_L2 && PS3PAD_LEFT == PAD_LEFT) ? 1 : -1];
+
+static volatile int s_exit_requested;
+
+void PS3_Plat_RequestExit(void) { s_exit_requested = 1; }
+int  PS3_Plat_ExitRequested(void) { return s_exit_requested; }
+
+uint64_t PS3_Plat_TimeUs(void) { return (uint64_t)sysGetSystemTime(); }
+
+void PS3_Plat_SleepUs(uint64_t us)
+{
+    if (us > 0) usleep((useconds_t)us);
+}
+
+void PS3_Plat_Pump(void)
+{
+    sysUtilCheckCallback();           /* without pumping the queue the event never arrives */
+    PS3_Pad_Frame();
+}
+
+void PS3_Plat_Pad(int port, ps3_padstate_t *out)
+{
+    memset(out, 0, sizeof(*out));
+    if (port != 0 || !PS3_Pad_Connected()) return;   /* one pad for now */
+    out->connected = 1;
+    out->buttons = PS3_Pad_Buttons();
+    out->lx = PS3_Pad_LeftX();
+    out->ly = PS3_Pad_LeftY();
+    out->rx = PS3_Pad_RightX();
+    out->ry = PS3_Pad_RightY();
+}
+
+void PS3_Plat_Exit(void)
+{
+    ps3_log("[9] shutdown");
+    PS3_Video_Shutdown();             /* rsxFinish: the RSX reads nothing any more */
+    PS3_Pad_Shutdown();
+    ps3_log("[9] shutdown complete");
+    ps3_log_shutdown();
+    exit(0);
+}
+
+void PS3_Plat_TextScreen(const char *title, const char *const *lines, int nlines)
+{
+    PS3_Video_TextScreen(title, lines, nlines, -1);
+}
+
+int PS3_Plat_LoadFile(const char *name, void *buf, int size)
+{
+    char path[512];
+    FILE *f;
+    int n;
+
+    snprintf(path, sizeof(path), "%s/%s", PS3_USRDIR, name);
+    f = fopen(path, "rb");
+    if (!f) return -1;
+    n = (int)fread(buf, 1, (size_t)size, f);
+    fclose(f);
+    return n;
+}
+
+int PS3_Plat_SaveFile(const char *name, const void *buf, int size)
+{
+    char path[512];
+    FILE *f;
+    int n;
+
+    snprintf(path, sizeof(path), "%s/%s", PS3_USRDIR, name);
+    f = fopen(path, "wb");
+    if (!f) return -1;
+    n = (int)fwrite(buf, 1, (size_t)size, f);
+    fclose(f);
+    return n;
+}
diff --git a/ps3/source/ps3_plat.h b/ps3/source/ps3_plat.h
new file mode 100644
index 0000000..ad55815
--- /dev/null
+++ b/ps3/source/ps3_plat.h
@@ -0,0 +1,43 @@
+/* ps3_plat.h -- what the game side asks of the platform side.
+ *
+ * Plain C types only. The game is compiled against the N64 headers
+ * (ultra64.h), which define u8/u16/u32... just like PSL1GHT's ppu-types.h, so
+ * no file may include both. Everything under source/game/ sees the PS3 through
+ * this header, ps3_log.h and ps3_rom.h; everything else never sees ultra64.h.
+ */
+
+#ifndef PS3_PLAT_H
+#define PS3_PLAT_H
+
+#include <stdint.h>
+
+/* DualShock 3 state for one port, already with the dead zone applied.
+ * buttons: PAD_* bits of ps3_pad.h. Sticks: -127..127, up and left negative. */
+typedef struct {
+    int connected;
