diff --git a/ps3/source/game/ps3_gfx_walk.c b/ps3/source/game/ps3_gfx_walk.c
new file mode 100644
index 0000000..4878846
--- /dev/null
+++ b/ps3/source/game/ps3_gfx_walk.c
@@ -0,0 +1,191 @@
+/* ps3_gfx_walk.c -- stage 1 stand-in for the renderer.
+ *
+ * Walks the frame's display list the way the RSP would (segments, nested
+ * display lists, the end of each list) without drawing anything, and counts
+ * what it finds. It checks the whole chain the renderer will depend on: the
+ * task the game builds, 8-byte commands, segment bases, and the addresses in
+ * data that comes straight from the ROM.
+ *
+ * Fast3DEX 0.95 (F3DEX_GBI + F3D_OLD), the microcode Mario Kart 64 uses.
+ */
+
+#include <ultra64.h>
+#include <PR/gbi.h>
+#include <string.h>
+
+#include "ps3_game.h"
+#include "ps3_gfx_walk.h"
+
+#define MAX_DEPTH 18                      /* F3DEX display list stack */
+#define MAX_COMMANDS 400000               /* a runaway list stops here */
+#define MAX_ERRORS_LOGGED 40
+
+ps3_gfx_stats_t gPs3GfxStats;
+
+static uintptr_t sSegment[16];
+static int sErrorsLogged;
+
+/* A real address on the PS3: not in the range reserved for segmented
+ * addresses, and not in the first 64 KB (nothing is mapped there). */
+static int plausible(uintptr_t a) {
+    return a >= 0x10000 && (a < 0x01000000 || a >= 0x10000000) && a < 0xE0000000UL;
+}
+
+static uintptr_t resolve(u32 w1) {
+    u32 seg = w1 >> 24;
+
+    if (seg >= 1 && seg <= 15) {
+        return sSegment[seg] + (w1 & 0x00FFFFFF);
+    }
+    return (uintptr_t) w1;
+}
+
+static void bad(const char* what, const Gfx* at, u32 w0, u32 w1, uintptr_t addr) {
+    gPs3GfxStats.errors++;
+    if (sErrorsLogged < MAX_ERRORS_LOGGED) {
+        sErrorsLogged++;
+        ps3_logf("[gfx] frame %u: %s at %p: w0 %08X w1 %08X -> 0x%lX (segment base 0x%lX)",
+                 gPs3GfxStats.frame, what, (const void*) at, w0, w1, (unsigned long) addr,
+                 (unsigned long) sSegment[(w1 >> 24) & 15]);
+    }
+}
+
+static void walk(const Gfx* dl) {
+    const Gfx* stack[MAX_DEPTH];
+    int depth = 0;
+    ps3_gfx_stats_t* st = &gPs3GfxStats;
+
+    for (;;) {
+        u32 w0 = dl->words.w0;
+        u32 w1 = ((const u32*) dl)[1];
+        u32 op = w0 >> 24;
+        const Gfx* cmd = dl++;
+
+        if (++st->commands > MAX_COMMANDS) {
+            bad("too many commands, giving up", cmd, w0, w1, 0);
+            return;
+        }
+
+        switch (op) {
+            case (u8) G_ENDDL:
+                if (depth == 0) {
+                    return;
+                }
+                dl = stack[--depth];
+                break;
+
+            case (u8) G_DL: {
+                uintptr_t target = resolve(w1);
+
+                st->dlCalls++;
+                if (!plausible(target)) {
+                    bad("G_DL to a bad address", cmd, w0, w1, target);
+                    break;
+                }
+                if (((w0 >> 16) & 0xFF) == G_DL_PUSH) {
+                    if (depth >= MAX_DEPTH) {
+                        bad("display list stack overflow", cmd, w0, w1, target);
+                        break;
+                    }
+                    stack[depth++] = dl;
+                    if ((u32) depth > st->maxDepth) {
+                        st->maxDepth = depth;
+                    }
+                }
+                dl = (const Gfx*) target;
+                break;
+            }
+
+            case (u8) G_MOVEWORD:
+                if (((w0 >> 16) & 0xFF) == G_MW_SEGMENT) {
+                    u32 seg = (w0 & 0xFFFF) / 4;
+
+                    if (seg < 16) {
+                        sSegment[seg] = (uintptr_t) w1;
+                        if (seg != 0 && w1 != 0 && !plausible(w1)) {
+                            bad("segment base is not a real address", cmd, w0, w1, w1);
+                        }
+                    }
+                }
+                break;
+
+            case (u8) G_VTX: {
+                uintptr_t v = resolve(w1);
+
+                st->vtxLoads++;
+                st->vertices += (w0 >> 10) & 0x3F;
+                if (!plausible(v)) {
+                    bad("G_VTX from a bad address", cmd, w0, w1, v);
+                }
+                break;
+            }
+
+            case (u8) G_MTX: {
+                uintptr_t m = resolve(w1);
+
+                st->matrices++;
+                if (!plausible(m)) {
+                    bad("G_MTX from a bad address", cmd, w0, w1, m);
+                }
+                break;
+            }
+
+            case (u8) G_MOVEMEM: {
+                uintptr_t m = resolve(w1);
+
+                if (!plausible(m)) {
+                    bad("G_MOVEMEM from a bad address", cmd, w0, w1, m);
+                }
+                break;
+            }
+
+            case (u8) G_TRI1:
+                st->triangles += 1;
+                break;
+            case (u8) G_TRI2:
+            case (u8) G_QUAD:
+                st->triangles += 2;
+                break;
+
+            case G_SETTIMG: {
+                uintptr_t t = resolve(w1);
+
+                st->textures++;
+                if (!plausible(t)) {
+                    bad("G_SETTIMG to a bad address", cmd, w0, w1, t);
+                }
+                break;
+            }
+
+            case G_TEXRECT:
+            case G_TEXRECTFLIP:
+                st->texRects++;
+                break;
+            case G_FILLRECT:
+                st->fillRects++;
+                break;
+
+            default:
+                break;
+        }
+    }
+}
+
+void ps3_gfx_run_task(void* taskPtr) {
+    OSTask* task = (OSTask*) taskPtr;
+    const Gfx* dl = (const Gfx*) task->t.data_ptr;
+    u32 frame = gPs3GfxStats.frame;
+    u32 errorsSoFar = gPs3GfxStats.totalErrors;
+
+    memset(&gPs3GfxStats, 0, sizeof(gPs3GfxStats));
+    gPs3GfxStats.frame = frame + 1;
+    gPs3GfxStats.totalErrors = errorsSoFar;
+
+    if (!plausible((uintptr_t) dl)) {
+        bad("the task's display list pointer is bad", dl, 0, 0, (uintptr_t) dl);
+    } else {
+        memset(sSegment, 0, sizeof(sSegment));
+        walk(dl);
+    }
+    gPs3GfxStats.totalErrors += gPs3GfxStats.errors;
+}
