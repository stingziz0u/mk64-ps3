diff --git a/ps3/source/game/ps3_decode.c b/ps3/source/game/ps3_decode.c
new file mode 100644
index 0000000..29b8b80
--- /dev/null
+++ b/ps3/source/game/ps3_decode.c
@@ -0,0 +1,79 @@
+/* ps3_decode.c -- the decompressors that are hand-written MIPS assembly in
+ * the original (asm/mio0_decode.s, asm/tkmk00_decode.s). */
+
+#include <ultra64.h>
+#include <string.h>
+
+#include "ps3_game.h"
+
+/* tools/libtkmk00.c, the C version of asm/tkmk00_decode.s. It reads and
+ * writes through explicit big-endian accessors, so its output is what the
+ * game expects on any host. */
+void tkmk00_decode(u8* tkmk, u8* tmp_buf, u8* rgba16, s32 alpha_color);
+
+#define BE32(p) (((u32) (p)[0] << 24) | ((u32) (p)[1] << 16) | ((u32) (p)[2] << 8) | (u32) (p)[3])
+
+/**
+ * MIO0: "MIO0", decoded size, offset of the compressed stream, offset of the
+ * raw stream, then one bit per output chunk (1 = a raw byte, 0 = a 16-bit
+ * back-reference: 4 bits of length - 3, 12 bits of distance - 1).
+ */
+void mio0decode(u8* in, u8* out) {
+    u32 size, written = 0;
+    const u8* comp;
+    const u8* raw;
+    const u8* bits = in + 16;
+    u32 mask = 0, cur = 0;
+
+    if (memcmp(in, "MIO0", 4) != 0) {
+        ps3_logf("[mio0] BAD header at %p: %02X %02X %02X %02X", (void*) in, in[0], in[1], in[2], in[3]);
+        return;
+    }
+    size = BE32(in + 4);
+    comp = in + BE32(in + 8);
+    raw = in + BE32(in + 12);
+
+    while (written < size) {
+        if (mask == 0) {
+            cur = *bits++;
+            mask = 0x80;
+        }
+        if (cur & mask) {
+            out[written++] = *raw++;
+        } else {
+            u32 len = (comp[0] >> 4) + 3;
+            u32 dist = (((u32) comp[0] & 0x0F) << 8) + comp[1] + 1;
+
+            comp += 2;
+            while (len-- != 0 && written < size) {
+                out[written] = out[written - dist];
+                written++;
+            }
+        }
+        mask >>= 1;
+    }
+}
+
+void tkmk00decode(u32* in, u8* tmp, u16* out, s32 alphaColor) {
+    tkmk00_decode((u8*) in, tmp, (u8*) out, alphaColor);
+}
+
+/* Only called from functions the game never calls. */
+void func_80040030(u8* in, u8* out) {
+    (void) in; (void) out;
+    ps3_log("[decode] func_80040030 (unused MIO0 variant) was called");
+}
+
+/* Ghost compression for the Controller Pak (src/replays.c). There is no
+ * Controller Pak yet, so nothing can ask for these. */
+s32 func_80040174(void* in, s32 size, s32 out) {
+    (void) in; (void) size; (void) out;
+    ps3_log("[decode] func_80040174 (ghost pre-encode) not implemented");
+    return 0;
+}
+
+s32 mio0encode(s32 in, s32 size, s32 out) {
+    (void) in; (void) size; (void) out;
+    ps3_log("[decode] mio0encode not implemented");
+    return 0;
+}
diff --git a/ps3/source/game/ps3_game.c b/ps3/source/game/ps3_game.c
new file mode 100644
index 0000000..352df72
--- /dev/null
+++ b/ps3/source/game/ps3_game.c
@@ -0,0 +1,117 @@
+/* ps3_game.c -- glue between the platform side and the game.
+ *
+ * Stage 1: the game runs for real (logic, menus, loading from the ROM,
+ * building display lists) but nothing is drawn. Each frame the screen shows
+ * what the display list walker counted; the same goes to the log for the
+ * first frames, on every game state change and once every 10 seconds.
+ */
+
+#include <ultra64.h>
+#include <stdio.h>
+
+#include "main.h"
+#include "code_800029B0.h"
+#include "ps3_game.h"
+#include "ps3_gfx_walk.h"
+#include "ps3_plat.h"
+#include "ps3_pad_bits.h"
+
+#define VBLANK_US 16683ULL                /* 59.94 Hz */
+
+extern u8 _memoryPoolSegmentNoloadStart[];
+extern u8 _racingSegmentStart[];
+
+void ps3_stage(const char* what) {
+    ps3_logf("[game] %s", what);
+}
+
+static void log_frame(const char* why) {
+    const ps3_gfx_stats_t* s = &gPs3GfxStats;
+
+    ps3_logf("[frame %u] %s: state %d, timer %d | cmds %u, dl %u (depth %u), vtx %u in %u loads, tris %u, "
+             "mtx %u, tex %u, texrect %u, fill %u, errors %u | heap %lu KB used, %lu KB free",
+             s->frame, why, (int) gGamestate, (int) gGlobalTimer, s->commands, s->dlCalls, s->maxDepth,
+             s->vertices, s->vtxLoads, s->triangles, s->matrices, s->textures, s->texRects, s->fillRects,
+             s->errors, (unsigned long) ((gNextFreeMemoryAddress - (uintptr_t) _memoryPoolSegmentNoloadStart) / 1024),
+             (unsigned long) ((gHeapEndPtr - gNextFreeMemoryAddress) / 1024));
+}
+
+static void status_screen(void) {
+    static char l[8][96];
+    const char* lines[8];
+    const ps3_gfx_stats_t* s = &gPs3GfxStats;
+    ps3_padstate_t pad;
+    int i, n = 0;
+
+    PS3_Plat_Pad(0, &pad);
+    snprintf(l[n++], 96, "Stage 1: the game runs, nothing is drawn yet.");
+    snprintf(l[n++], 96, "Frame %u   game state %d   timer %d", s->frame, (int) gGamestate, (int) gGlobalTimer);
+    snprintf(l[n++], 96, "Display list: %u commands, %u lists, depth %u", s->commands, s->dlCalls, s->maxDepth);
+    snprintf(l[n++], 96, "%u triangles, %u vertices, %u matrices, %u textures", s->triangles, s->vertices,
+             s->matrices, s->textures);
+    snprintf(l[n++], 96, "%u textured and %u filled rectangles", s->texRects, s->fillRects);
+    snprintf(l[n++], 96, "Bad addresses: %u this frame, %u in total", s->errors, s->totalErrors);
+    snprintf(l[n++], 96, "Pad: %04X  stick %d,%d", pad.buttons, pad.lx, pad.ly);
+    snprintf(l[n++], 96, "The pad works (try START, then Cross). SELECT+START: quit.");
+    for (i = 0; i < n; i++) {
+        lines[i] = l[i];
+    }
+    PS3_Plat_TextScreen("MK64-PS3", lines, n);
+}
+
+void ps3_frame_end(void) {
+    static uint64_t frameStart;
+    static s32 lastState = -1000;
+    static uint64_t lastLog;
+    uint64_t now, due;
+    ps3_padstate_t pad;
+    int vblanks, i;
+
+    if (gPs3GfxStats.frame <= 5) {
+        log_frame("first frames");
+    } else if (gGamestate != lastState) {
+        log_frame("game state changed");
+    } else if (PS3_Plat_TimeUs() - lastLog > 10000000ULL) {
+        log_frame("every 10 s");
+        lastLog = PS3_Plat_TimeUs();
+    }
+    lastState = gGamestate;
+
+    status_screen();
+
+    PS3_Plat_Pump();
+    PS3_Plat_Pad(0, &pad);
+    if (PS3_Plat_ExitRequested() ||
+        ((pad.buttons & PS3PAD_SELECT) && (pad.buttons & PS3PAD_START))) {
+        ps3_logf("[game] quitting at frame %u", gPs3GfxStats.frame);
+        PS3_Plat_Exit();
+    }
+
+    /* The game runs at 30 fps: a frame lasts two vblanks, or more if it took
+     * longer. The game counts the vblanks that went by to set its tick speed. */
+    now = PS3_Plat_TimeUs();
+    if (frameStart == 0 || now - frameStart > 30 * VBLANK_US) {
+        frameStart = now - 2 * VBLANK_US;   /* first frame, or a long stall (loading) */
+    }
+    vblanks = (int) ((now - frameStart + VBLANK_US - 1) / VBLANK_US);
+    if (vblanks < 2) {
+        vblanks = 2;
+    }
+    due = frameStart + (uint64_t) vblanks * VBLANK_US;
+    if (due > now) {
+        PS3_Plat_SleepUs(due - now);
+    }
+    frameStart = due;
+    for (i = 0; i < vblanks; i++) {
+        ps3_vblank();
+    }
+}
+
+void PS3_Game_Run(void) {
+    ps3_logf("[game] sizeof: Gfx %u, Vtx %u, Mtx %u, void* %u", (unsigned) sizeof(Gfx), (unsigned) sizeof(Vtx),
+             (unsigned) sizeof(Mtx), (unsigned) sizeof(void*));
+    ps3_logf("[game] heap %p .. %p (%lu KB)", (void*) _memoryPoolSegmentNoloadStart, (void*) _racingSegmentStart,
+             (unsigned long) ((_racingSegmentStart - _memoryPoolSegmentNoloadStart) / 1024));
+    ps3_romdata_load();
+    ps3_game_main();
+}
