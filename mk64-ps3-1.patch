+    {0x00,0x00,0x3c,0x76,0x66,0x67,0x7f,0x7f,0x67,0x66,0x76,0x3c,0x00,0x00,0x00,0x00}, /* '0' */
+    {0x00,0x00,0x3c,0x7c,0x1c,0x1c,0x1c,0x1c,0x1c,0x1c,0x1c,0x7f,0x00,0x00,0x00,0x00}, /* '1' */
