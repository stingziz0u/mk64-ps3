diff --git a/ps3/Makefile b/ps3/Makefile
new file mode 100644
index 0000000..aa83329
--- /dev/null
+++ b/ps3/Makefile
@@ -0,0 +1,138 @@
+#----------------------------------------------------------------------------
+# mk64-ps3 -- Mario Kart 64 (n64decomp/mk64) for PS3 homebrew (PSL1GHT)
+#
+# Stage 0: platform skeleton (log, pad, RSX text screen) + the ROM loader.
+# No game code yet.
+#
+#   make                  -> .pkg
+#   make clean
+#   make check-toolchain
+#
+# The packaging (.elf -> .self -> .pkg) is done entirely by ppu_rules with its
+# own pattern rules. Do NOT do it by hand: that skips the strip + sprxlinker
+# before signing and package_finalize after pkg.py, and the result installs
+# but does not run.
+#----------------------------------------------------------------------------
+
+ifeq ($(strip $(PS3DEV)),)
+$(error PS3DEV is not set. Run: export PS3DEV=/usr/local/ps3dev)
+endif
+
+include $(PS3DEV)/ppu_rules
+
+#----------------------------------------------------------------------------
+# Package identity
+#
+# APPID: EXACTLY 9 characters. With 8 the PS3 pads it to 9 with "_" and every
+# path built from it stops matching.
+#
+# ':=' and not '?=': ppu_rules defines TITLE and APPID with '?=' BEFORE these
+# lines, so with '?=' its defaults would win.
+#----------------------------------------------------------------------------
+TARGET    := mk64ps3
+TITLE     := mk64-ps3
+APPID     := MK64PS300
+CONTENTID := UP0001-$(APPID)_00-0000000000000000
+
+PKGFILES  := $(CURDIR)/pkgfiles
+ICON0     := $(CURDIR)/ICON0.PNG
+
+CC := ppu-gcc
+LD := ppu-gcc
+
+CFLAGS += -O2 -Wall -std=gnu11
+# Goes up by one with every patch; first line of the log and VERSION.TXT.
+PATCHLEVEL := 1
+
+CFLAGS += -D__PS3__ -DPS3_APPID=\"$(APPID)\" -DPS3_PATCHLEVEL=$(PATCHLEVEL)
+# -MMD -MP: changing a header rebuilds what includes it.
+CFLAGS += -MMD -MP
+CFLAGS += -Isource
+CFLAGS += $(LIBPSL1GHT_INC)
+
+# ps3_video.c goes at -O1 -fno-inline on purpose: PSL1GHT's syscall stubs are
+# data indirection symbols, not normal functions, and aggressive inlining
+# breaks their resolution at link time.
+CFLAGS_VIDEO := $(filter-out -O2,$(CFLAGS)) -O1 -fno-inline
+
+# -lrt and -llv2 are MANDATORY: without them the binary links with no errors,
+# the PKG installs, and opening it gives a black screen and back to the XMB
+# without ever reaching main().
+LIBS := gcm_sys rsx sysutil io audio rt lv2 m
+
+vpath %.c source
+
+SRCS := main.c ps3_log.c ps3_pad.c ps3_video.c ps3_rom.c
+OBJS := $(SRCS:.c=.o)
+
+.PHONY: all clean check-toolchain getlog
+
+VERSION := stage0
+OUT_PKG := mk64-ps3-$(VERSION).pkg
+
+# The PKG to install is the .gnpdrm.pkg (the one that went through
+# package_finalize), not the bare .pkg.
+all: $(TARGET).pkg
+	@cp $(TARGET).gnpdrm.pkg $(OUT_PKG)
+	@echo ""
+	@echo "PKG to install: $(CURDIR)/$(OUT_PKG)"
+	@ls -la $(OUT_PKG)
+
+%.o: %.c
+	$(CC) $(CFLAGS) -c $< -o $@
+
+ps3_video.o: source/ps3_video.c
+	$(CC) $(CFLAGS_VIDEO) -c $< -o $@
+
+$(TARGET).elf: $(OBJS)
+	$(LD) $(OBJS) $(LIBPSL1GHT_LIB) -o $(TARGET).elf $(foreach lib,$(LIBS),-l$(lib))
+
+#----------------------------------------------------------------------------
+# PKG content and icon
+#
+# pkgfiles/ mirrors the PKG, NOT its USRDIR: what must end up in USRDIR goes
+# in pkgfiles/USRDIR/. The game data does NOT go here: the user copies their
+# own ROM to USRDIR by FTP.
+#
+# The directory cannot be EMPTY ('cp -rf $(PKGFILES)/*' fails), so VERSION.TXT
+# is always written; it also tells which build is installed on the console.
+#----------------------------------------------------------------------------
+$(PKGFILES)/USRDIR/VERSION.TXT: $(OBJS)
+	@mkdir -p $(PKGFILES)/USRDIR
+	@echo "$(TITLE) -- $(VERSION) -- patch $(PATCHLEVEL) -- `date +%Y-%m-%d\ %H:%M`" > $@
+
+# XMB icon (320x176 PNG). If it is missing, a plain one is generated so the
+# build does not stop.
+$(ICON0):
+	@echo "No ICON0.PNG, generating a 320x176 placeholder..."
+	@python3 -c "import zlib,struct;w,h=320,176;\
+rows=b''.join(b'\x00'+bytes([200,30,30,255])*w for _ in range(h));\
+png=lambda t,d:struct.pack('>I',len(d))+t+d+struct.pack('>I',zlib.crc32(t+d));\
+open('$(ICON0)','wb').write(b'\x89PNG\r\n\x1a\n'+png(b'IHDR',struct.pack('>IIBBBBB',w,h,8,6,0,0,0))+png(b'IDAT',zlib.compress(rows))+png(b'IEND',b''))"
+
+$(TARGET).pkg: $(PKGFILES)/USRDIR/VERSION.TXT $(ICON0)
+
+-include $(OBJS:.o=.d)
+
+check-toolchain:
+	@echo "PS3DEV   = $(PS3DEV)"
+	@echo "ppu_rules: `test -f $(PS3DEV)/ppu_rules && echo OK || echo MISSING`"
+	@$(CC) --version | head -1
+	@echo "APPID    = $(APPID)  (length: `printf '%s' '$(APPID)' | wc -c`, MUST be 9)"
+	@for l in $(LIBS); do \
+	   if [ -f "$(PS3DEV)/ppu/lib/lib$$l.a" ]; then printf "  OK      lib%s.a\n" "$$l"; \
+	   elif $(CC) -print-file-name=lib$$l.a | grep -q /; then printf "  OK      lib%s.a (gcc sysroot)\n" "$$l"; \
+	   else printf "  MISSING lib%s.a\n" "$$l"; fi; \
+	 done
+
+# Optional: fetch the log without leaving the terminal.
+#   make getlog PS3IP=192.168.1.50
+PS3USER ?= anonymous:anonymous
+getlog:
+	@test -n "$(PS3IP)" || (echo "Usage: make getlog PS3IP=<ip>"; exit 1)
+	curl -s -u $(PS3USER) ftp://$(PS3IP)/dev_hdd0/game/$(APPID)/USRDIR/mk64_log.txt -o mk64_log.txt
+	@cat mk64_log.txt
+
+clean:
+	rm -f *.o *.d $(TARGET).elf $(TARGET).self $(TARGET).fake.self $(TARGET).pkg $(TARGET).gnpdrm.pkg
+	rm -rf build $(PKGFILES)
diff --git a/ps3/source/main.c b/ps3/source/main.c
new file mode 100644
index 0000000..46adce9
--- /dev/null
+++ b/ps3/source/main.c
@@ -0,0 +1,247 @@
+/* main.c -- mk64-ps3, stage 0.
+ *
+ * This binary is not Mario Kart 64 yet. It is the skeleton that checks, in
+ * order and leaving a trace in the log, every link that has broken before
+ * without giving any error:
+ *
+ *   [0] the binary reaches main()        -> if not, -lrt -llv2 are missing
+ *   [1] worker thread
+ *   [2] sysutil callback registered      -> without it, quitting from the PS
+ *                                           button restarts the console
+ *   [3] USRDIR is writable (the log lives there)
+ *   [4] pad
+ *   [5] RSX
+ *   [6] the user's ROM: found, byte order, checksum
+ *   [7] memory probe: where the heap, the stack and lv2 memory live
+ *   [8] result on screen until START or "Quit Game"
+ *   [9] clean shutdown
+ *
+ * If the screen stays black, the log says how far it got.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <dirent.h>
+
+#include <ppu-types.h>
+#include <ppu-lv2.h>
+#include <sys/thread.h>
+#include <sys/process.h>
+#include <sys/memory.h>
+#include <sysutil/sysutil.h>
+#include <lv2/systime.h>
+
+#include "ps3_log.h"
+#include "ps3_video.h"
+#include "ps3_pad.h"
+#include "ps3_rom.h"
+
+/* The loader reads this ELF section to size the primary thread's stack. */
+SYS_PROCESS_PARAM(1001, 0x100000);
+
+#define TITLE "MK64-PS3"
+
+static volatile int s_running = 1;
+
+static void sysutil_callback(u64 status, u64 param, void *userdata)
+{
+    (void)param;
+    (void)userdata;
+
+    if (status == SYSUTIL_EXIT_GAME) {
+        ps3_log("[sysutil] SYSUTIL_EXIT_GAME -> quitting");
+        s_running = 0;
+    }
+}
+
+static void list_dir(const char *path)
+{
+    DIR *d = opendir(path);
+    struct dirent *e;
+    int count = 0;
+
+    if (!d) {
+        ps3_logf("[fs] %s -> cannot open", path);
+        return;
+    }
+    while ((e = readdir(d)) != NULL) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+        if (count < 24) ps3_logf("[fs]     %s", e->d_name);
+        count++;
+    }
+    closedir(d);
+    ps3_logf("[fs] %s -> %d entries", path, count);
+}
+
+/* The game's data comes from the ROM with 32-bit addresses inside (display
+ * lists, tables). The plan is to keep those structures in their N64 layout,
+ * which only works if everything the game can point at lives below 4 GB.
+ * This prints where each kind of memory really is on the console. */
+struct lv2_meminfo { u32 total; u32 avail; };
+
+static void probe_memory(void)
+{
+    static int in_data = 1;
+    static int in_bss;
+    int on_stack = 0;
+    void *small = malloc(64);
+    void *big = malloc(16 * 1024 * 1024);
+    sys_mem_addr_t lv2 = 0;
+    struct lv2_meminfo info = { 0, 0 };
+    s32 r;
+
+    ps3_logf("[mem] sizeof: void* %u, long %u, int %u, size_t %u",
+             (unsigned)sizeof(void *), (unsigned)sizeof(long), (unsigned)sizeof(int),
+             (unsigned)sizeof(size_t));
+    ps3_logf("[mem] code   %p", (void *)probe_memory);
+    ps3_logf("[mem] .data  %p", (void *)&in_data);
+    ps3_logf("[mem] .bss   %p", (void *)&in_bss);
+    ps3_logf("[mem] stack  %p", (void *)&on_stack);
+    ps3_logf("[mem] malloc(64)    %p", small);
+    ps3_logf("[mem] malloc(16 MB) %p", big);
+    ps3_logf("[mem] ROM (12 MB)   %p", (void *)PS3_Rom_Data());
+
+    r = sysMemoryAllocate(1024 * 1024, SYS_MEMORY_PAGE_SIZE_1M, &lv2);
+    ps3_logf("[mem] sysMemoryAllocate(1 MB) -> %d, addr 0x%08X", (int)r, (unsigned)lv2);
+    if (r == 0) sysMemoryFree(lv2);
+
+    lv2syscall1(352, (u64)(unsigned long)&info);
+    ps3_logf("[mem] lv2 user memory: %u KB free of %u KB", info.avail / 1024, info.total / 1024);
+
+    free(big);
+    free(small);
+    (void)in_bss;
+}
+
+static void game_thread(void *arg)
+{
+    static char l_file[160], l_crc[96], l_mem[96];
+    const char *lines[8];
+    int n = 0, rc, armed = 0;
+    const char *name;
+
+    (void)arg;
+
+    ps3_log("[1] game_thread started");
+
+    ps3_log("[2] registering the sysutil callback");
+    sysUtilRegisterCallback(0, sysutil_callback, NULL);
+
+    ps3_log("[3] filesystem");
+    list_dir(PS3_USRDIR);
+
+    ps3_log("[4] pad");
+    if (PS3_Pad_Init() < 0)
+        ps3_log("[4] WARNING: ioPadInit failed, going on without a pad");
+
+    ps3_log("[5] video");
+    if (PS3_Video_Init() < 0) {
+        ps3_log("[5] FATAL: could not start the RSX");
+        goto done;
+    }
+    ps3_logf("[5] video %ux%u", (unsigned)PS3_Video_Width(), (unsigned)PS3_Video_Height());
+
+    {
+        static const char *const wait[] = { "Reading the ROM..." };
+        PS3_Video_TextScreen(TITLE, wait, 1, -1);
+    }
+
+    ps3_log("[6] ROM");
+    rc = PS3_Rom_Load(PS3_USRDIR);
+    ps3_logf("[6] PS3_Rom_Load -> %d", rc);
+
+    name = strrchr(PS3_Rom_Path(), '/');
+    name = name ? name + 1 : PS3_Rom_Path();
+
+    switch (rc) {
+        case PS3_ROM_OK:
+            snprintf(l_file, sizeof(l_file), "File: %s", name);
+            snprintf(l_crc, sizeof(l_crc), "CRC32 %08X: Mario Kart 64 (USA)", (unsigned)PS3_Rom_Crc32());
+            lines[n++] = "ROM OK.";
+            lines[n++] = l_file;
+            lines[n++] = l_crc;
+            break;
+        case PS3_ROM_NOT_FOUND:
+            lines[n++] = "No ROM found.";
+            lines[n++] = "Copy your own Mario Kart 64 (USA) ROM to";
+            lines[n++] = PS3_USRDIR;
+            lines[n++] = "(.z64, .v64 or .n64)";
+            break;
+        case PS3_ROM_BAD_SIZE:
+        case PS3_ROM_BAD_GAME:
+            snprintf(l_file, sizeof(l_file), "File: %s", name);
+            snprintf(l_crc, sizeof(l_crc), "CRC32 %08X, expected %08X", (unsigned)PS3_Rom_Crc32(),
+                     (unsigned)PS3_ROM_CRC32);
+            lines[n++] = "This is not the Mario Kart 64 (USA) ROM.";
+            lines[n++] = l_file;
+            if (rc == PS3_ROM_BAD_GAME) lines[n++] = l_crc;
+            else lines[n++] = "The ROM must be 12 MB.";
+            break;
+        default:
+            lines[n++] = "The ROM could not be read. See mk64_log.txt.";
+            break;
+    }
+
+    ps3_log("[7] memory probe");
+    probe_memory();
+    {
+        struct lv2_meminfo info = { 0, 0 };
+        lv2syscall1(352, (u64)(unsigned long)&info);
+        snprintf(l_mem, sizeof(l_mem), "Free memory: %u MB of %u MB", info.avail >> 20, info.total >> 20);
+        lines[n++] = "";
+        lines[n++] = l_mem;
+    }
+    lines[n++] = "Stage 0 (no game yet). START: quit.";
+
+    ps3_log("[8] result on screen; START or PS button -> Quit Game");
+    while (s_running) {
+        u16 b;
+
+        PS3_Video_TextScreen(TITLE, lines, n, -1);
+        sysUtilCheckCallback();        /* without pumping the queue the event never arrives */
+        PS3_Pad_Frame();
+        b = PS3_Pad_Buttons();
+        /* release everything first (a button may come held from the XMB) */
+        if (!b) armed = 1;
+        else if (armed && (b & PAD_START)) {
+            ps3_log("[8] START -> quitting");
+            break;
+        }
+        usleep(30000);
+    }
+
+done:
+    ps3_log("[9] shutdown");
+    PS3_Video_Shutdown();              /* rsxFinish: the RSX reads nothing any more */
+    PS3_Pad_Shutdown();
+    ps3_log("[9] shutdown complete");
+    ps3_log_shutdown();
+
+    sysThreadExit(0);
+}
+
+int main(int argc, char **argv)
+{
+    sys_ppu_thread_t tid;
+    u64 exit_code;
+
+    (void)argc;
+    (void)argv;
+
+    ps3_log_init();
+    ps3_log("[0] main() reached -- the link is fine (-lrt -llv2 present)");
+
+    /* The EBOOT's default thread has a small stack: the real work goes in a
+     * thread of its own. */
+    if (sysThreadCreate(&tid, game_thread, NULL, 1000, 2 * 1024 * 1024,
+                        THREAD_JOINABLE, "mk64") != 0) {
+        ps3_log("[0] FATAL: sysThreadCreate failed");
+        ps3_log_shutdown();
+        return 1;
+    }
+
+    sysThreadJoin(tid, &exit_code);
+    return 0;
+}
