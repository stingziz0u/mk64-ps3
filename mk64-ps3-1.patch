+    {0x00,0x00,0x70,0xd8,0xd8,0x73,0x0c,0x30,0x47,0x0d,0x0d,0x07,0x00,0x00,0x00,0x00}, /* '%' */
+    {0x00,0x00,0x3c,0x30,0x70,0x30,0x78,0x79,0xcf,0xcf,0x67,0x3f,0x00,0x00,0x00,0x00}, /* '&' */
+    {0x00,0x00,0x18,0x18,0x18,0x18,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00}, /* "'" */
+    {0x00,0x0c,0x0c,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x0c,0x0c,0x00,0x00,0x00}, /* '(' */
