+ * dibuja por CPU antes de que arranque el motor (conversion de la ROM).
+ * Generada desde DejaVu Sans Mono Bold (licencia libre, Bitstream Vera). */
+#ifndef PS3_FONT_H
+#define PS3_FONT_H
+static const unsigned char ps3_font8x16[95][16] = {
+    {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00}, /* ' ' */
+    {0x00,0x00,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x00,0x18,0x18,0x00,0x00,0x00,0x00}, /* '!' */
+    {0x00,0x00,0x66,0x66,0x66,0x66,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00}, /* '"' */
+    {0x00,0x00,0x1b,0x1b,0x12,0x7f,0x36,0x34,0xff,0x6c,0x6c,0x68,0x00,0x00,0x00,0x00}, /* '#' */
